MQTT_HOST=mqtt://mqtt:password@host:port
MQTT_TOPIC=home/gas-meter/cam

CONCIERGE_ADDR=http://localhost:8080
CONCIERGE_TOKEN=1234567890

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
# Max silence between SSE chunks (and before first response). Slow local vision can exceed
# wall-clock timeouts; idle timeout only fails when the stream stalls. Default: 120s.
# OPENAI_IDLE_TIMEOUT=120s

MONGO_URI=mongodb://localhost:27017
MONGO_DB=mqvision

